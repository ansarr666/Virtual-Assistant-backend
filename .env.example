# Copy to .env and fill in. Never commit .env.

# --- Core -------------------------------------------------------------------
LOG_LEVEL=INFO
# Browser origins allowed to call /chat (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex for preview/production frontend origins (e.g. Netlify)
CORS_ORIGIN_REGEX=https://[a-zA-Z0-9_.-]+\.netlify\.app

# --- Internal Storage: Google Sheets ("google_sheets") or in-memory ("memory", dev only) ---
REPOSITORY_BACKEND=google_sheets
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Leads
# Credentials - use ONE of these (or neither, to use your local gcloud login):
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Key JSON (or base64 of it) for servers, e.g. Render:
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Client Database Integrations (Optional, per-tenant or global fallback) ---
# Supabase REST Integration
SUPABASE_URL=
SUPABASE_KEY=

# --- Primary AI (Gemini) ----------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=   (optional - leave commented to use the built-in default: gemini-3.8-flash)
LLM_API_KEY=

# --- Backup AI Provider (OpenRouter) ----------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=8.0

# --- Knowledge base (RAG service) -------------------------------------------
RAG_API_BASE_URL=http://localhost:5000
RAG_TIMEOUT_SECONDS=10.0
RAG_API_KEY=

# --- Web chat API key (optional) --------------------------------------------
API_KEY=

# --- Meta (shared) ----------------------------------------------------------
# Webhook verify token you type into the Meta dashboard (any random string)
META_VERIFY_TOKEN=
# App Dashboard > App settings > Basic
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v20.0

# --- Facebook Messenger -----------------------------------------------------
FB_PAGE_ID=
# A PAGE access token (never-expiring when made from a long-lived user token)
FB_PAGE_ACCESS_TOKEN=

# --- Instagram (Instagram API with Instagram Login) ------------------------
# /me "user_id" of the business account (starts with 1784...)
IG_ACCOUNT_ID=
IG_ACCESS_TOKEN=
# Instagram > API setup with Instagram login: Instagram app ID / secret
IG_APP_ID=
IG_APP_SECRET=
IG_TOKEN_AUTO_REFRESH=true

# --- WhatsApp Cloud API -----------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
# System-user token, expiration "Never"
WHATSAPP_ACCESS_TOKEN=